# Variables for `docker compose` only. Compose reads a root .env automatically.
# Copy to .env to change them; every one has a default, so this file is optional.
# (The local dev server reads backend/.env instead, created by `npm run setup`.)

# Public placeholder: only safe on your own machine. Use your own secret (min 16 chars) anywhere else.
API_KEY=replace-me-with-a-long-random-secret

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=3000
REDIS_PORT=6379
