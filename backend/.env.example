# Copy to .env and adjust. All values are validated at startup (see src/config/env.ts).
PORT=3000
DB_PATH=payments.sqlite
# PLACEHOLDER ONLY - replace with your own random secret (min 16 chars). Never commit the real value.
API_KEY=replace-me-with-a-long-random-secret
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development

# Simulated payment gateway (latency in ms, rates between 0 and 1; the three rates must sum to <= 1)
GATEWAY_MIN_LATENCY_MS=100
GATEWAY_MAX_LATENCY_MS=800
GATEWAY_FAILURE_RATE=0.2
GATEWAY_DECLINE_RATE=0.1
GATEWAY_TIMEOUT_RATE=0.05
# How long the processor waits for one gateway call before aborting it
GATEWAY_TIMEOUT_MS=5000

# Background payment processor
PROCESSOR_POLL_INTERVAL_MS=1000
PROCESSOR_BATCH_SIZE=10
PROCESSOR_MAX_ATTEMPTS=5
